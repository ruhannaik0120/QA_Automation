{
  "ticket_runs_root": "ticket_runs",
  "logs_root": "logs",
  "output_root": "output",
  "ticket_path_pattern": "ticket_runs/<ticket-id>",
  "ticket_workspace": {
    "downloads": "downloads",
    "generated": "generated"
  },
  "input_acquisition": {
    "mode_source": "selected_workflow",
    "default_mode": null,
    "supported_modes": [
      "manual",
      "automatic"
    ],
    "workflow_must_declare_mode": true,
    "automatic_mode_requirements": [
      "explicit_workflow_permission",
      "required_acquisition_approvals_satisfied",
      "authentication_configured",
      "downloader_safety_controls_active"
    ]
  },
  "workflow_routing": {
    "workflows_root": "skills/workflows",
    "workflow_template": "skills/workflows/clientname_project_qaworkflow.md",
    "workflow_filename_pattern": "<client-name>_<project-type>_qaworkflow.md",
    "workflow_variant_filename_pattern": "<client-name>_<project-type>_<workflow-variant>_qaworkflow.md",
    "required_routing_fields": [
      "client_name",
      "project_type"
    ],
    "optional_routing_fields": [
      "workflow_variant"
    ],
    "active_workflow_document_type": "qa_workflow",
    "required_non_null_approval_fields": [
      "approved_by",
      "approved_on"
    ],
    "approval_metadata_exempt_workflows": [],
    "agent_skills_root": "skills/agent_skills",
    "skill_instruction_filename": "SKILL.md"
  },
  "run_specific_configuration": {
    "example_path": "ticket_run_config.example.json",
    "local_override_path": "ticket_run_config.local.json",
    "local_override_must_be_gitignored": true,
    "secrets_allowed": false,
    "required_non_null_approval_fields": [
      "approved_by",
      "approved_on"
    ]
  },
  "runtime_resolution": {
    "precedence": [
      "authoritative_jira_ticket_context",
      "selected_approved_workflow",
      "explicit_run_specific_configuration",
      "authorized_user_clarification",
      "never_guess"
    ],
    "lower_precedence_values_may_only_fill_missing_fields": true,
    "conflict_behavior": "block_and_request_authorized_clarification",
    "missing_required_behavior": "block_before_workspace_initialization"
  },
  "run_configuration_schema": {
    "routing": {
      "required_fields": [
        "client_name",
        "project_type"
      ],
      "optional_fields": [
        "workflow_variant"
      ]
    },
    "jira": {
      "required_fields": [
        "retrieval_mode",
        "issue_key"
      ],
      "at_least_one_required_field": [
        "site_url",
        "cloud_id"
      ],
      "allowed_retrieval_modes": [
        "direct_issue"
      ]
    },
    "input_sources": {
      "type": "array",
      "supported_source_types": [
        "direct_file",
        "github_package"
      ],
      "common_fields": [
        "source_type",
        "authentication_profile",
        "credential_environment_variable",
        "allowed_extensions"
      ],
      "direct_file_required_fields": [
        "source_type",
        "url",
        "allowed_extensions"
      ],
      "github_package_required_fields": [
        "source_type",
        "repository",
        "ref",
        "package_path",
        "allowed_extensions"
      ]
    },
    "database_targets": {
      "type": "array",
      "required_fields_when_declared": [
        "db_type",
        "database",
        "schema",
        "source_object",
        "target_object"
      ],
      "optional_fields": [
        "connection_profile"
      ],
      "profile_selection": "explicit_or_unique_secret_safe_metadata_match_only"
    },
    "workflow_approval": {
      "optional_fields": [
        "approval_metadata_exempt_workflows"
      ],
      "default_approval_metadata_exempt_workflows": []
    },
    "required_report_dependencies": {
      "type": "array",
      "default": []
    }
  },
  "stable_artifact_paths": {
    "ticket_context": "generated/ticket_context.md",
    "qa_plan": "generated/qa_plan.md",
    "generated_sql": "generated/generated_sql/generated_queries.sql",
    "approvals": "generated/approvals/approval_log.md",
    "execution_results": "generated/execution_results/execution_result.json",
    "workflow_log": "logs/<ticket-id>.log",
    "html_report": "output/<ticket-id>/report.html",
    "excel_report": "output/<ticket-id>/report.xlsx"
  },
  "execution_result_schema_version": "1.0",
  "validation_statuses": [
    "passed",
    "failed",
    "executed_not_evaluated",
    "execution_failed"
  ],
  "supported_export_formats": [
    "json_only",
    "html",
    "excel",
    "both"
  ],
  "approval_checkpoint_scope": "Baseline controls for database-validation workflows. An approved client workflow may add stricter or client-specific checkpoints but must not bypass security or MCP confirmations.",
  "human_approval_checkpoints": [
    {
      "id": "ticket_context_complete",
      "required_before": "qa_planning",
      "description": "The user confirms that the combined Jira context and relevant approved local inputs are complete enough for QA planning."
    },
    {
      "id": "database_execution",
      "required_before": "approved_read_only_sql_execution",
      "description": "The user approves the exact read-only statements, profile mappings, order, expected results, and stop conditions."
    },
    {
      "id": "write_operation",
      "required_before": "each_ddl_dml_or_environment_change",
      "description": "The user separately authorizes any DDL, DML, or environment-changing operation; read-only approval never grants it."
    }
  ],
  "mcp_boundaries": {
    "atlassian_mcp": "Jira ticket context retrieval only.",
    "database_mcp": "Database profile selection, connection checks, metadata inspection, and approved query execution only.",
    "workflow_layer": "Coordinates external ticket inputs under downloads, generated ticket evidence under generated, shared logs, and final outputs outside MCP.",
    "credentials": "Keep credentials in approved secret or database-profile configuration; never store them in run artifacts."
  }
}
