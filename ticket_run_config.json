{
  "ticket_runs_root": "ticket_runs",
  "logs_root": "logs",
  "output_root": "output",
  "ticket_path_pattern": "ticket_runs/<ticket-id>",
  "ticket_workspace": {
    "downloads": "downloads",
    "generated": "generated"
  },
  "workflow_routing": {
    "workflows_root": "skills/workflows",
    "workflow_template": "skills/workflows/clientname_project_qaworkflow.md",
    "workflow_filename_pattern": "<client-name>_<project-type>_qaworkflow.md",
    "workflow_variant_filename_pattern": "<client-name>_<project-type>_<workflow-variant>_qaworkflow.md",
    "required_routing_fields": [
      "client_name",
      "project_type"
    ],
    "optional_routing_fields": [
      "workflow_variant"
    ],
    "active_workflow_document_type": "qa_workflow",
    "required_non_null_approval_fields": [
      "approved_by",
      "approved_on"
    ],
    "approval_metadata_exempt_workflows": [
      "skills/workflows/ruhan_poc_qaworkflow.md"
    ],
    "agent_skills_root": "skills/agent_skills",
    "skill_instruction_filename": "SKILL.md"
  },
  "route_selected_configuration": [
    {
      "routing": {
        "client_name": "ruhan",
        "project_type": "poc",
        "workflow_variant": null
      },
      "jira": {
        "site_url": "https://ruhannaik444.atlassian.net",
        "cloud_id": "51cd9d76-2810-472a-8b50-b2412c213a7f",
        "retrieval_mode": "direct_issue"
      },
      "input_repository": {
        "repository": "rnnaik1102-droid/QA_Automation_POC_Inputs",
        "ref": "main",
        "package_path": "qa_packages/flight_delay_poc",
        "authentication_profile": "qa-poc-github",
        "credential_environment_variable": "QA_POC_GITHUB_TOKEN",
        "allowed_extensions": [
          ".md",
          ".json",
          ".sql"
        ]
      },
      "protected_attachment_mirrors": [
        {
          "source_role": "technical_implementation_specification",
          "path": "qa_packages/flight_delay_poc/supporting_documents/Flight_Delay_Request_Deployment_Document.docx",
          "availability": "authorized_bootstrap_and_validation_required"
        },
        {
          "source_role": "developer_unit_test_evidence",
          "path": "qa_packages/flight_delay_poc/supporting_documents/Flight_Delay_Developer_Unit_Test_Results.xlsx",
          "availability": "authorized_bootstrap_and_validation_required"
        }
      ],
      "database_targets": [
        {
          "db_type": "postgresql",
          "database": "flight_delay_poc",
          "source_object": "raw.flights",
          "target_object": "analytics.flight_performance",
          "qa_schema": "qa"
        },
        {
          "db_type": "snowflake",
          "database": "FLIGHT_DELAY_POC",
          "source_object": "RAW.FLIGHTS",
          "target_object": "ANALYTICS.FLIGHT_PERFORMANCE",
          "qa_schema": "QA"
        }
      ],
      "required_report_dependencies": [
        "openpyxl"
      ]
    }
  ],
  "stable_artifact_paths": {
    "ticket_context": "generated/ticket_context.md",
    "qa_plan": "generated/qa_plan.md",
    "generated_sql": "generated/generated_sql/generated_queries.sql",
    "approvals": "generated/approvals/approval_log.md",
    "execution_results": "generated/execution_results/execution_result.json",
    "workflow_log": "logs/<ticket-id>.log",
    "html_report": "output/<ticket-id>/report.html",
    "excel_report": "output/<ticket-id>/report.xlsx"
  },
  "execution_result_schema_version": "1.0",
  "validation_statuses": [
    "passed",
    "failed",
    "executed_not_evaluated",
    "execution_failed"
  ],
  "supported_export_formats": [
    "json_only",
    "html",
    "excel",
    "both"
  ],
  "approval_checkpoint_scope": "Baseline controls for the tested database-validation workflow. An approved client workflow may add stricter or client-specific checkpoints but must not bypass security or MCP confirmations.",
  "human_approval_checkpoints": [
    {
      "id": "ticket_context_complete",
      "required_before": "qa_planning",
      "description": "The user confirms that the combined Jira context and relevant local downloaded sources are complete enough for QA planning."
    },
    {
      "id": "database_execution",
      "required_before": "approved_read_only_sql_execution",
      "description": "The user approves the exact read-only statements, profile mappings, order, expected results, and stop conditions."
    },
    {
      "id": "write_operation",
      "required_before": "each_ddl_dml_or_environment_change",
      "description": "The user separately authorizes any DDL, DML, or environment-changing operation; read-only approval never grants it."
    }
  ],
  "mcp_boundaries": {
    "atlassian_mcp": "Jira ticket context retrieval only.",
    "database_mcp": "Database profile selection, connection checks, metadata inspection, and approved query execution only.",
    "workflow_layer": "Coordinates external ticket inputs under downloads, generated ticket evidence under generated, shared logs, and final outputs outside MCP.",
    "credentials": "Keep credentials in approved secret or database-profile configuration; never store them in run artifacts."
  }
}
